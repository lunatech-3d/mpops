--- /dev/null
+++ b/app/verify_database.py
@@ -0,0 +1,23 @@
+"""Print non-sensitive database deployment diagnostics."""
+
+from app.security.auth import AuthService
+
+
+def main() -> None:
+    auth = AuthService()
+    with auth.connect() as connection:
+        tables = [row[0] for row in connection.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")]
+        migrations = [row[0] for row in connection.execute("SELECT name FROM SchemaMigrations ORDER BY name")]
+        violations = connection.execute("PRAGMA foreign_key_check").fetchall()
+        print(f"Database path: {auth.settings.database_path}")
+        print(f"Tables: {', '.join(tables)}")
+        print(f"Applied migrations: {', '.join(migrations) or '(none)'}")
+        print(f"Foreign-key check: {'OK' if not violations else f'{len(violations)} violation(s)'}")
+        print(f"User count: {connection.execute('SELECT count(*) FROM Users').fetchone()[0]}")
+        print(f"Technician count: {connection.execute('SELECT count(*) FROM Techs').fetchone()[0]}")
+        print(f"Technician-address count: {connection.execute('SELECT count(*) FROM TechAddresses').fetchone()[0]}")
+
+
+if __name__ == "__main__":
+    main()
