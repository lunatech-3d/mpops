diff --git a/database/migrations/002_reconcile_legacy.py b/database/migrations/002_reconcile_legacy.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a9332ec8481c3e06a6417bc0b692499205731c0
--- /dev/null
+++ b/database/migrations/002_reconcile_legacy.py
@@ -0,0 +1,81 @@
+"""Normalize supported legacy Matterport Ops schemas without losing records."""
+
+SCHEMA = """
+CREATE TABLE Users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL COLLATE NOCASE UNIQUE,
+ password_hash TEXT NOT NULL, display_name TEXT, role TEXT NOT NULL DEFAULT 'operator' CHECK(role IN ('admin','operator','viewer')),
+ is_active INTEGER NOT NULL DEFAULT 0 CHECK(is_active IN (0,1)), last_login_at TEXT,
+ created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, created_by INTEGER, updated_at TEXT, updated_by INTEGER,
+ FOREIGN KEY(created_by) REFERENCES Users(id), FOREIGN KEY(updated_by) REFERENCES Users(id));
+CREATE TABLE AuditLog (id INTEGER PRIMARY KEY AUTOINCREMENT, occurred_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+ actor_user_id INTEGER, subject_user_id INTEGER, action TEXT NOT NULL, details_json TEXT NOT NULL DEFAULT '{}',
+ FOREIGN KEY(actor_user_id) REFERENCES Users(id), FOREIGN KEY(subject_user_id) REFERENCES Users(id));
+CREATE TABLE Techs (tech_id INTEGER PRIMARY KEY AUTOINCREMENT, tech_code TEXT NOT NULL COLLATE NOCASE UNIQUE,
+ first_name TEXT NOT NULL, last_name TEXT NOT NULL, preferred_name TEXT, status TEXT NOT NULL DEFAULT 'Active',
+ email TEXT, mobile_phone TEXT, home_phone TEXT, hire_date TEXT, termination_date TEXT, notes TEXT,
+ created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, created_by INTEGER NOT NULL, updated_at TEXT, updated_by INTEGER,
+ FOREIGN KEY(created_by) REFERENCES Users(id), FOREIGN KEY(updated_by) REFERENCES Users(id));
+CREATE TABLE TechAddresses (address_id INTEGER PRIMARY KEY AUTOINCREMENT, tech_id INTEGER NOT NULL,
+ address_1 TEXT NOT NULL, address_2 TEXT, city TEXT NOT NULL, state TEXT NOT NULL, zip_code TEXT NOT NULL,
+ is_primary INTEGER NOT NULL DEFAULT 1 CHECK(is_primary IN (0,1)), effective_date TEXT, end_date TEXT,
+ created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, created_by INTEGER NOT NULL, updated_at TEXT, updated_by INTEGER,
+ FOREIGN KEY(tech_id) REFERENCES Techs(tech_id), FOREIGN KEY(created_by) REFERENCES Users(id),
+ FOREIGN KEY(updated_by) REFERENCES Users(id));
+CREATE INDEX idx_AuditLog_occurred_at ON AuditLog(occurred_at);
+CREATE INDEX idx_AuditLog_actor_user_id ON AuditLog(actor_user_id);
+CREATE INDEX idx_AuditLog_subject_user_id ON AuditLog(subject_user_id);
+CREATE INDEX idx_Techs_status ON Techs(status);
+CREATE INDEX idx_Techs_name ON Techs(last_name, first_name);
+CREATE INDEX idx_TechAddresses_tech_id ON TechAddresses(tech_id);
+"""
+
+TABLES = ("Users", "AuditLog", "Techs", "TechAddresses")
+FIELDS = {
+ "Users": ("id","username","password_hash","display_name","role","is_active","last_login_at","created_at","created_by","updated_at","updated_by"),
+ "AuditLog": ("id","occurred_at","actor_user_id","subject_user_id","action","details_json"),
+ "Techs": ("tech_id","tech_code","first_name","last_name","preferred_name","status","email","mobile_phone","home_phone","hire_date","termination_date","notes","created_at","created_by","updated_at","updated_by"),
+ "TechAddresses": ("address_id","tech_id","address_1","address_2","city","state","zip_code","is_primary","effective_date","end_date","created_at","created_by","updated_at","updated_by"),
+}
+ALIASES = {"address_1":"address1", "address_2":"address2"}
+
+def _expression(field, columns):
+    source = columns.get(field.lower()) or columns.get(field.replace("_", "").lower()) \
+        or columns.get(ALIASES.get(field, ""))
+    if source:
+        return '"' + source.replace('"', '""') + '"'
+    defaults = {"role":"'operator'", "is_active":"1", "created_at":"CURRENT_TIMESTAMP",
+                "status":"'Active'", "details_json":"'{}'", "is_primary":"1"}
+    return defaults.get(field, "NULL")
+
+def migrate(connection):
+    existing = {r[0].replace("_", "").lower(): r[0] for r in connection.execute(
+        "SELECT name FROM sqlite_master WHERE type='table'")}
+    counts = {}
+    for table in reversed(TABLES):
+        actual = existing.get(table.replace("_", "").lower())
+        if actual:
+            counts[table] = connection.execute(f'SELECT count(*) FROM "{actual}"').fetchone()[0]
+            connection.execute(f'ALTER TABLE "{actual}" RENAME TO "__legacy_{table}"')
+    for statement in SCHEMA.split(";"):
+        if statement.strip():
+            connection.execute(statement)
+    for table in TABLES:
+        legacy = f"__legacy_{table}"
+        if table not in counts:
+            continue
+        columns = {}
+        for row in connection.execute(f'PRAGMA table_info("{legacy}")'):
+            columns[row[1].lower()] = row[1]
+            columns[row[1].replace("_", "").lower()] = row[1]
+        fields = FIELDS[table]
+        select = ",".join(_expression(field, columns) for field in fields)
+        connection.execute(f'INSERT INTO "{table}" ({",".join(fields)}) SELECT {select} FROM "{legacy}"')
+        if connection.execute(f'SELECT count(*) FROM "{table}"').fetchone()[0] != counts[table]:
+            raise RuntimeError(f"row-count validation failed for {table}")
+    # Resolve legacy duplicate-primary data while retaining every address row.
+    connection.execute("""UPDATE TechAddresses SET is_primary=0 WHERE is_primary=1 AND address_id NOT IN
+        (SELECT MIN(address_id) FROM TechAddresses WHERE is_primary=1 GROUP BY tech_id)""")
+    for table in reversed(TABLES):
+        if table in counts:
+            connection.execute(f'DROP TABLE "__legacy_{table}"')
+    connection.execute("""CREATE UNIQUE INDEX ux_TechAddresses_primary
+        ON TechAddresses(tech_id) WHERE is_primary=1""")
